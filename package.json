	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"postinstall": "svelte-kit sync",
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"test:unit": "vp test",
		"test": "vp test --run"
	},
	"dependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"daisyui": "^5.7.50",
		"dexie": "^4.4.7",
		"moosmann-svelte": "^0.6.2",
		"nanoid": "^6.0.2",
		"sortablejs": "^1.15.7",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.5",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/sortablejs": "^1.15.9",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"micromark": "^4.0.3",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"rollup-license-plugin": "^3.2.1",
		"sharp": "^0.35.5",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": "~24.18.0"
	},
	"engineStrict": true,
	"packageManager": "pnpm@10.33.2"
